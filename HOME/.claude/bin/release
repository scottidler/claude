#!/usr/bin/env bash
# release — deterministic release driver. Removes LLM discretion from the one
# layer that keeps failing: gate detection + tag/push ordering.
#
# The whole release problem is binary (Scott's framing, and it really is):
#
#   1. main is GATED   -> the version bump RIDES THE FEATURE PR (bump --no-tag on
#                         the feature branch, before merge). AFTER the PR merges:
#                         pull main, tag the merged tip, push the tag by name.
#                         NEVER a bump-only release branch. NEVER a tag on a branch
#                         (squash-merge rewrites the SHA — the tag is burnt forever).
#   2. main is UNGATED -> land the VERSION COMMIT first (bump --no-tag), push main,
#                         WAIT FOR CI TO GO GREEN ON THAT SHA, and only then
#                         bump --tag-only + push the tag by name.
#
# Why the wait, in both flows: a tag is the one artifact that cannot be taken
# back. If the tag is created before CI has run, every failure CI finds can only
# be fixed by ANOTHER tag, so one intended release burns two version numbers.
# That is the "double-tap" (otto v2.0.2/v2.0.3, v2.0.4/v2.0.5, and v2.0.0/v2.0.1
# before them: each pair is one release plus its immediate fix-up). Landing the
# version commit untagged costs nothing when CI is red: fix it, re-run `release`,
# and the SAME version number gets tagged. Only the tag waits.
#
# This script is the mechanical executor of exactly the commands the bump/shipit
# skills document — same `bump` calls, same safe push order — but with NO room
# for the model to "rationalize" a wrong path mid-flow. Every HALL-OF-SHAME entry
# is the model exercising discretion at a decision point; this deletes the
# decision points.
#
# IMPORTANT: this runs `bump`/`git push` as SUBPROCESSES, so the PreToolUse
# git-release-guard hook never sees them. The safety therefore lives HERE:
#   - never `git push --tags` (tag pushed by explicit name, only after the
#     branch/commit is confirmed on origin)
#   - never bump a dirty tree (refuse unless the tree is clean)
#   - never tag a gated repo before the merge (bump --no-tag / bump --tag-only)
#   - never force-push, never delete tags, never a bump-only release branch
#
# Contract: the CODE CHANGE IS ALREADY COMMITTED (clean tree; on the default
# branch for ungated, on the feature branch for gated). The caller owns the
# diff-reading judgment (what to commit, the message). This driver owns
# everything mechanical from there.
#
# Usage:
#   release [-m|-M] [--install "<cmd>"|--no-install] [-n] [--no-ci-gate] [--ci-timeout N]
#   release --finish [--install "<cmd>"|--no-install] [-n] [--no-ci-gate] [--ci-timeout N]
#
#   --no-ci-gate     tag without waiting for CI. This re-arms the double-tap;
#                    use it only when there is no CI to wait for.
#   --ci-timeout N   seconds to wait for checks to finish (default 1800).
#
set -euo pipefail

# ---- args ---------------------------------------------------------------------
LEVEL=""          # "", "-m", or "-M" passed through to bump
INSTALL_CMD=""    # explicit install command (caller usually reads CLAUDE.md)
NO_INSTALL=0
DRYRUN=0
FINISH=0
CI_GATE=1         # wait for green CI on the pushed SHA before the tag exists
CI_TIMEOUT=1800   # seconds to wait for checks to complete
CI_APPEAR=120     # seconds to wait for any check to register at all

# Print the leading comment block, however long it is, so editing the docs
# above can never desync a hardcoded line range.
usage() { awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; exit "${1:-0}"; }

while [ $# -gt 0 ]; do
  case "$1" in
    -m|--minor)   LEVEL="-m" ;;
    -M|--major)   LEVEL="-M" ;;
    --install)    INSTALL_CMD="${2:-}"; shift ;;
    --no-install) NO_INSTALL=1 ;;
    -n|--dry-run) DRYRUN=1 ;;
    --finish)     FINISH=1 ;;
    --no-ci-gate) CI_GATE=0 ;;
    --ci-timeout) CI_TIMEOUT="${2:?--ci-timeout needs seconds}"; shift ;;
    -h|--help)    usage 0 ;;
    *) echo "release: unknown argument: $1" >&2; usage 1 ;;
  esac
  shift
done

# ---- helpers ------------------------------------------------------------------
die()  { echo "release: $*" >&2; exit 1; }
say()  { printf '\033[1;36m▶ %s\033[0m\n' "$*"; }
run()  { if [ "$DRYRUN" = 1 ]; then echo "  [dry-run] $*"; else echo "  + $*"; eval "$@"; fi; }

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a git repo"

DEFAULT=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's@^origin/@@' || true)
if [ -z "$DEFAULT" ]; then
  if   git rev-parse --verify --quiet main   >/dev/null; then DEFAULT=main
  elif git rev-parse --verify --quiet master >/dev/null; then DEFAULT=master
  else die "cannot determine default branch (no origin/HEAD, no main/master)"; fi
fi
BRANCH=$(git rev-parse --abbrev-ref HEAD)

# ---- the anti-double-tap machinery -------------------------------------------
# A tag is the only irreversible artifact in a release. Everything below exists
# so that a tag is never created for a commit whose CI has not finished green.

tag_exists_local()  { git rev-parse -q --verify "refs/tags/$1" >/dev/null 2>&1; }
tag_exists_remote() { [ -n "$(git ls-remote --tags origin "refs/tags/$1" 2>/dev/null)" ]; }
tag_exists_any()    { tag_exists_local "$1" || tag_exists_remote "$1"; }

# `bump -n` prints "bump: <current> -> <target>"; take both from bump so the
# numbers are always bump's opinion and never this script's arithmetic.
bump_versions() { bump -n "$@" 2>&1; }

# Is the manifest version already committed but not yet tagged?
#
# That is the state a previous `release` leaves behind when CI came back red:
# the version commit landed, no tag was cut. Re-running must then tag THAT
# version rather than bumping past it, which is the whole point of the change.
# A repo with no tags at all is NOT this state (a first release still bumps),
# and the check reads tags rather than commit messages so a custom
# `--message` cannot fool it.
version_commit_pending() {
  local cur="$1"
  [ -n "$cur" ] || return 1
  git describe --tags --abbrev=0 --match 'v*' >/dev/null 2>&1 || return 1
  tag_exists_any "v$cur" && return 1
  return 0
}

# Block until every check on $1 has completed, and refuse the tag on any failure.
#
# No tag exists when this is called, so a red result costs a re-run and nothing
# else. Compare with the old order (tag first, push, then watch CI): there, the
# only way to fix anything CI found was a second tag.
wait_for_green() {
  local sha="$1"
  if [ "$CI_GATE" = 0 ]; then say "CI gate: SKIPPED (--no-ci-gate) — a red run will cost you a second tag"; return 0; fi
  if [ "$DRYRUN" = 1 ]; then echo "  [dry-run] wait for CI to go green on $sha, then tag"; return 0; fi

  local repo
  repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)
  if [ -z "$repo" ]; then say "CI gate: no GitHub repo — nothing to wait on"; return 0; fi

  say "CI gate: waiting on checks for $sha (no tag exists yet, so red is free)"
  local start deadline json total incomplete failed
  start=$(date +%s)
  deadline=$(( start + CI_TIMEOUT ))

  while :; do
    json=$(gh api "repos/$repo/commits/$sha/check-runs" 2>/dev/null || echo '{"check_runs":[]}')
    total=$(printf '%s' "$json"      | jq '[.check_runs[]?] | length')
    incomplete=$(printf '%s' "$json" | jq '[.check_runs[]? | select(.status != "completed")] | length')
    failed=$(printf '%s' "$json"     | jq '[.check_runs[]? | select(.conclusion != null and ([.conclusion] | inside(["success","skipped","neutral"]) | not))] | length')

    if [ "$failed" -gt 0 ]; then
      echo
      printf '%s' "$json" | jq -r '.check_runs[] | select(.conclusion != null and ([.conclusion] | inside(["success","skipped","neutral"]) | not)) | "  FAILED  \(.name)  \(.html_url)"'
      echo
      die "CI is RED on $sha. NO TAG WAS CREATED, which is the point: fix it, commit, and re-run 'release'. It will tag the SAME version rather than bumping past it, so this costs zero version numbers."
    fi

    if [ "$total" -gt 0 ] && [ "$incomplete" = 0 ]; then
      say "CI gate: green ($total checks) — cutting the tag"
      return 0
    fi

    local now; now=$(date +%s)
    if [ "$total" = 0 ] && [ $(( now - start )) -ge "$CI_APPEAR" ]; then
      say "CI gate: no checks registered on $sha after ${CI_APPEAR}s — nothing to wait on"
      return 0
    fi
    [ "$now" -lt "$deadline" ] || die "CI gate: timed out after ${CI_TIMEOUT}s with $incomplete check(s) still running on $sha. NO TAG WAS CREATED. Re-run 'release' when they finish (it will reuse the same version), or pass --ci-timeout."

    printf '  … %s/%s checks complete\r' "$(( total - incomplete ))" "$total"
    sleep 15
  done
}

# install step — shared by both modes
do_install() {
  if [ "$NO_INSTALL" = 1 ]; then say "install: skipped (--no-install)"; return; fi
  local cmd="$INSTALL_CMD"
  if [ -z "$cmd" ]; then
    if [ -f Cargo.toml ]; then cmd="cargo install --path ."
    else say "install: no command given and not a Rust crate — skipped"; return; fi
  fi
  say "install: $cmd"
  run "$cmd"
}

# ---- FINISH mode: gated post-merge tag+push -----------------------------------
if [ "$FINISH" = 1 ]; then
  say "finish (gated post-merge): tag the merged tip of $DEFAULT and push it by name"
  run "git checkout $DEFAULT"
  run "git fetch origin $DEFAULT"
  run "git pull --ff-only origin $DEFAULT"
  # A squash merge creates a NEW commit on $DEFAULT, and its CI has not
  # necessarily finished. Tagging it early is the same double-tap as the ungated
  # path, so it waits here too.
  if [ "$DRYRUN" = 0 ]; then wait_for_green "$(git rev-parse HEAD)"; else wait_for_green "<HEAD>"; fi
  # bump --tag-only refuses unless HEAD == origin/<default>, so it physically
  # cannot orphan a tag. This is the whole okta-auth-rs guard, mechanized.
  run "bump --tag-only"
  if [ "$DRYRUN" = 0 ]; then
    VER=$(git tag --points-at HEAD --list 'v*' | head -1)
    [ -n "$VER" ] || die "bump --tag-only produced no v* tag at HEAD — STOP, inspect manually"
    run "git push origin $VER"
  else
    echo "  [dry-run] git push origin <vX.Y.Z from bump --tag-only>"
  fi
  do_install
  say "done — gated release finished, tag on origin/$DEFAULT"
  exit 0
fi

# ---- START mode: preconditions ------------------------------------------------
[ -z "$(git status --porcelain)" ] || die "tree is dirty. Commit your real code change first (specific files, good message); the driver only does the mechanical release on a CLEAN tree (this is how the marquee asset-sweep was avoided)."

run "git fetch origin $DEFAULT"

# Gate detection — bump checks BOTH layers (classic protection AND repo/org
# rulesets). This is the single source of truth; never infer gates by hand.
GATES=$(bump --gates 2>&1 || true)
echo "$GATES"
if printf '%s\n' "$GATES" | grep -qiE 'Gates:[[:space:]]*none|ungated'; then
  GATED=0
elif printf '%s\n' "$GATES" | grep -qiE 'not a github remote'; then
  # No GitHub remote -> no GitHub ruleset can gate it. Safe to treat as ungated.
  GATED=0
elif printf '%s\n' "$GATES" | grep -qiE 'gated'; then
  GATED=1
else
  # gh unauthenticated / API error / genuinely indeterminate on a GitHub repo.
  # REFUSE rather than guess — guessing "ungated" here is exactly how a gated
  # repo gets a tag pushed straight at it and orphaned.
  die "gate status is UNKNOWN for a GitHub repo — refusing to guess. Run 'gh auth status' and retry. Output was:"$'\n'"$GATES"
fi

# ---- UNGATED: version commit lands first, tag waits for green CI --------------
# Order is deliberate and is the fix for the double-tap:
#   bump --no-tag -> push main -> WAIT FOR CI -> bump --tag-only -> push tag
# The old order tagged local HEAD before CI had ever seen the commit, so every
# failure CI found could only be repaired by a second tag. Now a red CI leaves
# no tag at all, and the re-run reuses the same version number.
if [ "$GATED" = 0 ]; then
  [ "$BRANCH" = "$DEFAULT" ] || die "ungated release runs from the default branch ($DEFAULT); you are on '$BRANCH'. Land your work on $DEFAULT first."
  BEHIND=$(git rev-list --count "HEAD..origin/$DEFAULT" 2>/dev/null || echo 0)
  [ "$BEHIND" = 0 ] || die "$DEFAULT is $BEHIND commit(s) behind origin/$DEFAULT — pull/rebase before releasing (tagging a stale main is how cr v0.1.8 was orphaned)."

  # Both numbers come from bump's own dry-run, never from arithmetic here.
  PREVIEW=$(bump_versions $LEVEL || true)
  CURVER=$(printf '%s\n' "$PREVIEW" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
  TARGET=$(printf '%s\n' "$PREVIEW" | grep -oE 'v[0-9]+\.[0-9]+\.[0-9]+' | head -1)

  if version_commit_pending "$CURVER"; then
    # A previous run landed the version commit and stopped short of the tag,
    # which is exactly what a red CI is supposed to leave behind.
    TAG="v$CURVER"
    say "RESUMING: $TAG is already committed and carries no tag — tagging that version, NOT bumping past it"
  else
    AHEAD=$(git rev-list --count "origin/$DEFAULT..HEAD" 2>/dev/null || echo 0)
    [ "$AHEAD" -gt 0 ] || die "nothing to release: HEAD == origin/$DEFAULT and tree is clean. Commit a change first."
    [ -n "$TARGET" ] || die "could not parse target version from 'bump -n $LEVEL':"$'\n'"$PREVIEW"
    TAG="$TARGET"
    say "UNGATED release of $TAG on $DEFAULT (version commit first; the tag waits for CI)"
    run "bump --no-tag $LEVEL"
  fi

  # Push the commit with NO tag attached. --no-follow-tags because a stray
  # push.followTags=true is the mechanism behind two of the confirmed orphans.
  run "git push --no-follow-tags origin $DEFAULT"

  if [ "$DRYRUN" = 0 ]; then
    HEADSHA=$(git rev-parse HEAD)
    [ "$HEADSHA" = "$(git rev-parse "origin/$DEFAULT")" ] || die "HEAD is not origin/$DEFAULT after the push — STOP, inspect manually before any tag is cut."
    wait_for_green "$HEADSHA"
  else
    wait_for_green "<HEAD>"
  fi

  # bump --tag-only refuses unless HEAD == origin/<default>, so the tag cannot
  # land on a commit that is not already published.
  if tag_exists_local "$TAG"; then
    say "tag $TAG already exists locally (prior interrupted run) — pushing it"
  else
    run "bump --tag-only"
  fi
  if [ "$DRYRUN" = 0 ]; then
    TAG=$(git tag --points-at HEAD --list 'v*' | head -1)
    [ -n "$TAG" ] || die "bump --tag-only produced no v* tag at HEAD — STOP, inspect manually"
  fi
  run "git push origin $TAG"
  do_install
  say "done — $TAG pushed; tag on origin/$DEFAULT, cut on green CI"
  exit 0
fi

# ---- GATED: the version bump rides the FEATURE PR ------------------------------
# No tag exists until the PR merges; the tag is cut on the merged tip of the
# default branch by `release --finish`. There is NEVER a bump-only release branch.

if [ "$BRANCH" = "$DEFAULT" ]; then
  AHEAD=$(git rev-list --count "origin/$DEFAULT..HEAD" 2>/dev/null || echo 0)
  if [ "$AHEAD" = 0 ]; then
    die "gated repo, nothing to release from $DEFAULT. The version bump rides the FEATURE PR: run this from the feature branch (code committed) and it will 'bump --no-tag' + push + open the PR. If a PR already merged WITHOUT its bump: STOP — never create a bump-only release branch; fold the bump into the next feature PR or ask Scott."
  fi
  # Commits stranded on local $DEFAULT of a gated repo can never push directly.
  # Move them to a feature branch (named after the change, NOT release-*) — this
  # IS the feature branch: it carries the code, and the bump joins it below.
  SUBJ=$(git log --reverse --format=%s "origin/$DEFAULT..HEAD" | head -1)
  SLUG=$(printf '%s' "$SUBJ" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-40)
  [ -n "$SLUG" ] || SLUG="change-$(git rev-parse --short HEAD)"
  say "GATED repo: moving your $AHEAD commit(s) off local $DEFAULT onto feature branch '$SLUG' (a version commit cannot land on gated $DEFAULT except via PR)"
  run "git branch $SLUG"
  run "git reset --hard origin/$DEFAULT"   # tree is clean here; $DEFAULT back to identical-with-origin
  run "git checkout $SLUG"
  BRANCH="$SLUG"
fi

say "GATED release — bump rides the feature PR '$BRANCH' (no tag until it merges)"

# Idempotency: if this branch already carries the version bump (re-run after a
# failed push / PR revision), don't double-bump.
if git diff "origin/$DEFAULT...HEAD" -- Cargo.toml pyproject.toml package.json 2>/dev/null | grep -Eq '^\+version'; then
  say "version already bumped on this branch — skipping 'bump --no-tag'"
else
  run "bump --no-tag $LEVEL"               # version commit joins the PR; NO tag exists
fi

run "git push --no-follow-tags -u origin $BRANCH"

if [ "$DRYRUN" = 0 ]; then
  PRSTATE=$(gh pr view "$BRANCH" --json state -q .state 2>/dev/null || true)
  if [ "$PRSTATE" = "OPEN" ]; then
    PRURL=$(gh pr view "$BRANCH" --json url -q .url 2>/dev/null || true)
    say "PR already open${PRURL:+: $PRURL}"
  else
    run "gh pr create --fill --head $BRANCH --base $DEFAULT"
    PRURL=$(gh pr view "$BRANCH" --json url -q .url 2>/dev/null || true)
    say "PR opened${PRURL:+: $PRURL}"
  fi
  echo
  echo "  This is a GATED repo — the tag cannot exist until the PR merges."
  echo "  After it merges (CI + review), run:   release --finish${NO_INSTALL:+ --no-install}${INSTALL_CMD:+ --install \"$INSTALL_CMD\"}"
else
  echo "  [dry-run] gh pr create --fill --head $BRANCH --base $DEFAULT  (then, after merge: release --finish)"
fi
say "paused — waiting on PR merge"
