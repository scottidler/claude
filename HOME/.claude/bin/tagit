#!/usr/bin/env bash
# tagit - enforce the release-tagging flow so tags can never orphan
#
# The one invariant: a tag is never created or pushed until the exact commit
# it points to is confirmed reachable from origin/<default-branch>.
#
# Flow is decided from BOTH live gates (classic branch protection AND
# repo/org rulesets). Org rulesets are not bypassed by repo admin.
#
#   tagit gates              show both gates and the decided flow
#   tagit release [bumpargs] ungated repos: bump, push main, VERIFY, then push tag
#   tagit pr [-m|-M]         gated repos: open a version-bump PR (no tag)
#   tagit tag                gated repos, after the bump PR merges: tag main, push tag
#
# Hard rules baked in:
#   - never `git push --tags`, never followTags; tags pushed by explicit refspec only
#   - branch/main push is verified to have landed BEFORE the tag is pushed
#   - never deletes or moves a tag; conflicts abort with instructions for the user
set -euo pipefail

die() { echo "tagit: ERROR: $*" >&2; exit 1; }
log() { echo "tagit: $*" >&2; }

require() { command -v "$1" >/dev/null 2>&1 || die "required tool '$1' not found"; }
require git
require gh
require jq

git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a git repository"

SLUG="$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)" \
    || die "cannot resolve owner/repo from origin (gh repo view failed)"
DEFAULT="$(gh api "repos/$SLUG" --jq .default_branch)"

# ---------------------------------------------------------------- gates ----

# classic_gate: "clear" or "gated"
classic_gate() {
    if gh api "repos/$SLUG/branches/$DEFAULT/protection" >/dev/null 2>&1; then
        echo gated
    else
        echo clear
    fi
}

# ruleset_gate: "clear" or "gated".
# deletion / non_fast_forward rules don't block a normal push; anything else
# (pull_request, workflows, required_status_checks, ...) forces PR flow.
ruleset_gate() {
    local blocking
    blocking="$(gh api "repos/$SLUG/rules/branches/$DEFAULT" \
        --jq '[.[] | select(.type != "deletion" and .type != "non_fast_forward")] | length')"
    if [[ "$blocking" -gt 0 ]]; then echo gated; else echo clear; fi
}

flow() {
    if [[ "$(classic_gate)" == clear && "$(ruleset_gate)" == clear ]]; then
        echo direct
    else
        echo pr
    fi
}

cmd_gates() {
    local c r
    c="$(classic_gate)"; r="$(ruleset_gate)"
    echo "repo:               $SLUG (default branch: $DEFAULT)"
    echo "classic protection: $c"
    echo "rulesets:           $r  (repo+org; admin does NOT bypass org rulesets)"
    if [[ "$c" == clear && "$r" == clear ]]; then
        echo "flow:               direct  -> use: tagit release"
    else
        echo "flow:               pr      -> use: tagit pr, then after merge: tagit tag"
    fi
}

# -------------------------------------------------------------- helpers ----

current_branch() { git branch --show-current; }

require_on_default() {
    [[ "$(current_branch)" == "$DEFAULT" ]] \
        || die "must be on '$DEFAULT' (currently on '$(current_branch)')"
}

require_clean() {
    [[ -z "$(git status --porcelain)" ]] \
        || die "working tree not clean; commit or stash first"
}

require_synced() {
    git fetch origin "$DEFAULT" --quiet
    local local_sha remote_sha
    local_sha="$(git rev-parse HEAD)"
    remote_sha="$(git rev-parse "origin/$DEFAULT")"
    if [[ "$local_sha" != "$remote_sha" ]]; then
        git merge-base --is-ancestor "$local_sha" "$remote_sha" \
            && die "local $DEFAULT is behind origin; run: git pull --ff-only origin $DEFAULT"
        die "local $DEFAULT has commits not on origin/$DEFAULT ($local_sha); resolve that first - do NOT tag here"
    fi
}

# read current version from Cargo.toml or pyproject.toml
read_version() {
    if [[ -f Cargo.toml ]]; then
        grep -m1 -E '^version *= *"' Cargo.toml | sed -E 's/^version *= *"([^"]+)".*/\1/'
    elif [[ -f pyproject.toml ]]; then
        grep -m1 -E '^version *= *"' pyproject.toml | sed -E 's/^version *= *"([^"]+)".*/\1/'
    else
        die "no Cargo.toml or pyproject.toml; cannot determine version"
    fi
}

next_version() { # $1=current $2=level(patch|minor|major)
    local major minor patch
    IFS=. read -r major minor patch <<<"$1"
    case "$2" in
        major) echo "$((major + 1)).0.0" ;;
        minor) echo "$major.$((minor + 1)).0" ;;
        patch) echo "$major.$minor.$((patch + 1))" ;;
        *) die "unknown bump level '$2'" ;;
    esac
}

write_version() { # $1=new version
    if [[ -f Cargo.toml ]]; then
        sed -i -E "0,/^version *= *\"[^\"]+\"/s//version = \"$1\"/" Cargo.toml
        # sync the lockfile entry for the local crate(s)
        if [[ -f Cargo.lock ]]; then cargo check -q >/dev/null 2>&1 || true; fi
    elif [[ -f pyproject.toml ]]; then
        sed -i -E "0,/^version *= *\"[^\"]+\"/s//version = \"$1\"/" pyproject.toml
    fi
}

tag_exists_remote() { # $1=tag
    [[ -n "$(git ls-remote origin "refs/tags/$1")" ]]
}

# verify a ref landed on the remote at the expected sha
verify_remote() { # $1=refspec $2=expected commit sha
    local got
    got="$(git ls-remote origin "$1" | awk '{print $1}')"
    [[ -n "$got" ]] || return 1
    # annotated tags: remote sha is the tag object; compare peeled commit
    if [[ "$1" == refs/tags/* ]]; then
        got="$(git rev-list -n1 "${1#refs/tags/}")"
    fi
    [[ "$got" == "$2" ]]
}

push_tag_checked() { # $1=tag
    local tag="$1" commit
    commit="$(git rev-list -n1 "$tag")"
    git fetch origin "$DEFAULT" --quiet
    git merge-base --is-ancestor "$commit" "origin/$DEFAULT" \
        || die "REFUSING to push tag '$tag': its commit $commit is NOT on origin/$DEFAULT (this is how tags get orphaned)"
    git push origin "refs/tags/$tag"
    verify_remote "refs/tags/$tag" "$commit" || die "tag '$tag' did not land on origin as expected"
    log "tag $tag pushed and verified on origin (commit $commit on $DEFAULT)"
}

# -------------------------------------------------------------- release ----

cmd_release() {
    require bump
    [[ "$(flow)" == direct ]] \
        || die "'$DEFAULT' on $SLUG is gated (protection/ruleset). Use: tagit pr  (then after merge: tagit tag)"
    require_on_default
    git fetch origin "$DEFAULT" --quiet
    git merge-base --is-ancestor "$(git rev-parse "origin/$DEFAULT")" HEAD \
        || die "local $DEFAULT is behind origin/$DEFAULT; run: git pull --ff-only origin $DEFAULT"

    bump "$@"

    local tag
    tag="$(git tag --points-at HEAD --list 'v*' | sort -V | /usr/bin/tail -1)"
    [[ -n "$tag" ]] || die "bump did not leave a v* tag on HEAD"

    # push the branch FIRST, tags explicitly excluded
    git push --no-follow-tags origin "$DEFAULT" \
        || die "push of $DEFAULT rejected - DO NOT push the tag. Report the rejection."
    verify_remote "refs/heads/$DEFAULT" "$(git rev-parse HEAD)" \
        || die "$DEFAULT did not land on origin - DO NOT push the tag"
    log "$DEFAULT pushed and verified"

    push_tag_checked "$tag"
}

# ------------------------------------------------------------------- pr ----

cmd_pr() {
    local level=patch
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -m|--minor) level=minor ;;
            -M|--major) level=major ;;
            *) die "unknown arg '$1' (use -m or -M)" ;;
        esac
        shift
    done

    [[ "$(flow)" == pr ]] || die "repo is not gated; just use: tagit release"
    require_on_default
    require_clean
    require_synced

    local cur new tag branch
    cur="$(read_version)"
    new="$(next_version "$cur" "$level")"
    tag="v$new"
    tag_exists_remote "$tag" && die "tag $tag already exists on origin; pick a different level or resolve with the user"

    branch="bump-$tag"
    git checkout -b "$branch"
    write_version "$new"
    git add -A
    git commit -m "Bump version to $tag"
    git push --no-follow-tags -u origin "$branch"
    gh pr create --base "$DEFAULT" --head "$branch" \
        --title "Bump version to $tag" \
        --body "Version bump $cur -> $new. No tag yet - after this merges, run: tagit tag"
    git checkout "$DEFAULT"
    log "bump PR open. After it merges: git pull --ff-only origin $DEFAULT && tagit tag"
}

# ------------------------------------------------------------------ tag ----

cmd_tag() {
    [[ "$(flow)" == pr ]] || log "note: repo is ungated; 'tagit release' is the normal path here"
    require_on_default
    require_clean
    git fetch origin "$DEFAULT" --quiet
    git merge-base --is-ancestor HEAD "origin/$DEFAULT" \
        || die "local $DEFAULT has commits not on origin - resolve before tagging"
    git pull --ff-only origin "$DEFAULT" --quiet

    local ver tag head
    ver="$(read_version)"
    tag="v$ver"
    head="$(git rev-parse HEAD)"

    if git rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
        local at; at="$(git rev-list -n1 "$tag")"
        [[ "$at" == "$head" ]] || die "tag $tag already exists locally at $at (HEAD is $head). NEVER delete/move tags - ask the user."
        log "tag $tag already exists locally at HEAD"
    else
        git tag -a "$tag" -m "$tag"
        log "created annotated tag $tag at $head"
    fi

    if tag_exists_remote "$tag"; then
        verify_remote "refs/tags/$tag" "$head" \
            || die "tag $tag exists on origin pointing at a DIFFERENT commit. NEVER delete/move tags - ask the user."
        log "tag $tag already on origin and correct - nothing to do"
        return 0
    fi

    push_tag_checked "$tag"
}

# ----------------------------------------------------------------- main ----

usage() {
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

[[ $# -ge 1 ]] || usage 1
cmd="$1"; shift
case "$cmd" in
    gates)   cmd_gates "$@" ;;
    release) cmd_release "$@" ;;
    pr)      cmd_pr "$@" ;;
    tag)     cmd_tag "$@" ;;
    -h|--help|help) usage 0 ;;
    *) die "unknown command '$cmd' (gates|release|pr|tag)" ;;
esac
