#!/usr/bin/env bash
# gen-tools — regenerate ~/.claude/tools.md, the index of Scott's own CLIs.
#
# Lists every binary in ~/.cargo/bin that was `cargo install`-ed from a local
# source under ~/repos (i.e. built from his own crates), minus anything that is
# already exposed another way (a dedicated skill, an MCP server) or explicitly
# excluded below. Descriptions come from each crate's Cargo.toml `description`,
# falling back to the `--help` about line.
#
# The result is @-included by CLAUDE.md, so the inventory is always in context;
# Claude runs `<tool> --help` just-in-time for specifics. Re-run after adding a
# tool: `~/.claude/bin/gen-tools`.
set -euo pipefail

skills_dir="$HOME/.claude/skills"
out="$HOME/.claude/tools.md"

# Locally-installed binaries to leave OUT of the index. Edit as the toolkit grows.
#   - already MCP servers (discoverable as MCP):  oracle, multi-account-github-mcp
#   - daemons / merge drivers / sub-entries:      aka-daemon, taskstore-merge
#   - skills under a differently-named dir:       scaffold (scaffold-rust-repo), rwl (rwl-a-plan)
exclude=(
  oracle multi-account-github-mcp
  aka-daemon taskstore-merge
  scaffold rwl
)

is_excluded() { local b=$1 e; for e in "${exclude[@]}"; do [[ $b == "$e" ]] && return 0; done; return 1; }

# Parse `cargo install --list`. A package line ends in "(<source>):"; only local
# paths "(/...)" are Scott's own builds. crates.io / git sources are third-party.
declare -A bin_path
cur=""
while IFS= read -r line; do
  if [[ $line =~ ^[^[:space:]].*\((/[^\)]+)\):$ ]]; then
    cur="${BASH_REMATCH[1]}"                       # local crate dir
  elif [[ $line =~ ^[^[:space:]] ]]; then
    cur=""                                         # non-local source -> skip its bins
  elif [[ -n $cur && $line =~ ^[[:space:]]+([A-Za-z0-9_.-]+)$ ]]; then
    bin_path["${BASH_REMATCH[1]}"]="$cur"
  fi
done < <(cargo install --list)

desc_of() {
  local bin=$1 path=${bin_path[$1]} d=""
  if [[ -f $path/Cargo.toml ]]; then
    d=$(grep -m1 '^description[[:space:]]*=' "$path/Cargo.toml" \
        | sed -E 's/^description[[:space:]]*=[[:space:]]*"?([^"]*)"?[[:space:]]*$/\1/')
  fi
  if [[ -z $d ]]; then
    d=$(timeout 5 "$bin" --help </dev/null 2>/dev/null | awk 'NF{print; exit}')
    case $d in Usage:*|Traceback*|thread\ *) d="" ;; esac
  fi
  printf '%s' "$d"
}

{
  echo "## My CLIs"
  echo
  echo "<!-- GENERATED by ~/.claude/bin/gen-tools — do not edit by hand. -->"
  echo "<!-- Re-run \`~/.claude/bin/gen-tools\` after installing a new custom binary. -->"
  echo
  echo "Custom binaries in \`~/.cargo/bin\`, built from \`~/repos\`. Run \`<tool> --help\` for details."
  echo
  for bin in $(printf '%s\n' "${!bin_path[@]}" | sort); do
    is_excluded "$bin" && continue
    [[ -d "$skills_dir/$bin" ]] && continue           # already has a dedicated skill
    command -v "$bin" >/dev/null 2>&1 || continue     # must resolve on PATH
    d=$(desc_of "$bin")
    [[ -n $d ]] && echo "- \`$bin\` — $d" || echo "- \`$bin\` — (no description; add one to Cargo.toml)"
  done
} > "$out"

echo "wrote $out ($(grep -c '^- ' "$out") tools)"
