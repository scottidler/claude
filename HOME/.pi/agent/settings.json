{
  "defaultProvider": "anthropic",
  "defaultThinkingLevel": "high",
  "theme": "dracula",
  "defaultProjectTrust": "always",
  "quietStartup": false,
  "defaultTools": [
    "read",
    "bash",
    "edit",
    "write",
    "grep",
    "find",
    "ls"
  ],
  "enableSkillCommands": true,
  "skills": [
    "~/.claude/skills",
    "-~/.claude/skills/aka",
    "-~/.claude/skills/allow-readonly",
    "-~/.claude/skills/architect-agy",
    "-~/.claude/skills/building-researcher",
    "-~/.claude/skills/cidr",
    "-~/.claude/skills/clauderize",
    "-~/.claude/skills/closeday",
    "-~/.claude/skills/core",
    "-~/.claude/skills/diagnose",
    "-~/.claude/skills/dot-clauderize",
    "-~/.claude/skills/e2e-v3",
    "-~/.claude/skills/football-researcher",
    "-~/.claude/skills/gha-versions",
    "-~/.claude/skills/grill-with-docs",
    "-~/.claude/skills/gx",
    "-~/.claude/skills/improve-codebase-architecture",
    "-~/.claude/skills/install-skills",
    "-~/.claude/skills/intent-layer",
    "-~/.claude/skills/karpathy-guidelines",
    "-~/.claude/skills/keyby",
    "-~/.claude/skills/ls-git-repos",
    "-~/.claude/skills/ls-owners",
    "-~/.claude/skills/ls-stale-branches",
    "-~/.claude/skills/ls-stale-prs",
    "-~/.claude/skills/mina",
    "-~/.claude/skills/modern-tools",
    "-~/.claude/skills/openday",
    "-~/.claude/skills/ottofile",
    "-~/.claude/skills/python-coder",
    "-~/.claude/skills/relocate-targets",
    "-~/.claude/skills/reposlug",
    "-~/.claude/skills/rkvr",
    "-~/.claude/skills/run-via",
    "-~/.claude/skills/rwl-a-plan",
    "-~/.claude/skills/slack-old",
    "-~/.claude/skills/spec-review",
    "-~/.claude/skills/spotify-playlist",
    "-~/.claude/skills/tdd",
    "-~/.claude/skills/teach",
    "-~/.claude/skills/to-google-drive",
    "-~/.claude/skills/vault-recall",
    "-~/.claude/skills/whitespace",
    "-~/.claude/skills/writing-researcher",
    "-~/.claude/skills/xray",
    "-~/.claude/skills/zoom-out"
  ],
  "enabledModels": [
    "anthropic/*opus*",
    "anthropic/*sonnet*",
    "openai/*gpt-5*",
    "google/*gemini-3*"
  ],
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 48000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 0
    }
  },
  "externalEditor": "nvim",
  "markdown": {
    "mermaid": "streaming"
  },
  "warnings": {
    "anthropicExtraUsage": true
  }
}
